<Window x:Class="CANalyzer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="CANalyzer Professional" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
        </Style>
        
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="5"/>      <!-- Progress bar -->
            <RowDefinition Height="*"/>      <!-- Main content -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Height="50">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <TextBlock Text="CANalyzer" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#569CD6"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Professional" 
                           FontSize="14" 
                           Foreground="#D4D4D4"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#333333" Height="50" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Основные кнопки -->
                <Button x:Name="LoadButton" 
                        Content="📁 Load CAN Log" 
                        Width="150"
                        Click="LoadButton_Click"
                        ToolTip="Load CAN log file (CSV, ASC, TRC formats)"/>
                
                <Button x:Name="AnalyzeDBCButton" 
                        Content="🔍 Analyze with DBC" 
                        Width="150"
                        Click="AnalyzeWithDBCButton_Click"
                        Background="#28a745"
                        Margin="10,0,0,0"
                        ToolTip="Analyze log using DBC databases and machine learning"/>
                
                <Button x:Name="GenerateDBCButton" 
                        Content="⚙️ Generate DBC" 
                        Width="150"
                        Click="GenerateDBCButton_Click"
                        Background="#6c757d"
                        Margin="10,0,0,0"
                        ToolTip="Generate DBC file from detected signals"/>
                
                <Button x:Name="ExportResultsButton" 
                        Content="📊 Export Results" 
                        Width="150"
                        Click="ExportResultsButton_Click"
                        Background="#6f42c1"
                        Margin="10,0,0,0"
                        ToolTip="Export all analysis results"/>
                
                <Button x:Name="ClearResultsButton" 
                        Content="🗑️ Clear" 
                        Width="100"
                        Click="ClearResultsButton_Click"
                        Background="#dc3545"
                        Margin="10,0,0,0"
                        ToolTip="Clear all results"/>
                
                <Button x:Name="TestButton" 
                        Content="🧪 Test Data" 
                        Width="120"
                        Click="CreateTestDataButton_Click"
                        Background="#17a2b8"
                        Margin="10,0,0,0"
                        ToolTip="Create test CAN messages for demonstration"/>
                
                <!-- Status Text -->
                <TextBlock x:Name="StatusText" 
                           Text="Ready" 
                           Foreground="#D4D4D4"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>
        
        <!-- Progress Bar -->
        <ProgressBar x:Name="ProgressBar" 
                     Grid.Row="2"
                     Height="5" 
                     Background="Transparent"
                     Foreground="#007ACC"
                     IsIndeterminate="False"
                     Visibility="Collapsed"/>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="3" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Info Panel -->
            <Border x:Name="InfoPanel" 
                    Grid.Row="0"
                    Background="#252526" 
                    Margin="0,0,0,10" 
                    Padding="15" 
                    CornerRadius="5"
                    Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="📊 Analysis Information" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#569CD6"/>
                    <TextBlock x:Name="DataInfoText" 
                               Text="No data loaded" 
                               Foreground="#D4D4D4"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Tab Control for 3 Panels -->
            <TabControl Grid.Row="1" Background="#1E1E1E">
                <!-- Panel 1: Raw Data & Basic Analysis -->
                <TabItem Header="📊 Raw Data & Statistics">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Raw Messages -->
                        <Border Grid.Column="0" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="📋 Raw CAN Messages" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <DataGrid x:Name="RawMessagesGrid" 
                                          Grid.Row="1"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                        <DataGridTextColumn Header="Time (ms)" Binding="{Binding Timestamp, StringFormat=F2}" Width="80"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                        <DataGridTextColumn Header="DLC" Binding="{Binding DLC}" Width="40"/>
                                        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="EXT" Binding="{Binding IsExtended}" Width="50"/>
                                        <DataGridCheckBoxColumn Header="FD" Binding="{Binding IsCANFD}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Detected Signals -->
                        <Border Grid.Column="2" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🔍 Detected Signals" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <DataGrid x:Name="DetectedSignalsGrid" 
                                          Grid.Row="1"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="80"/>
                                        <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="120"/>
                                        <DataGridTextColumn Header="Start Bit" Binding="{Binding StartBit}" Width="60"/>
                                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="60"/>
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinValue}" Width="60"/>
                                        <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}" Width="60"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Panel 2: DBC Matching & Correlations -->
                <TabItem Header="🎯 DBC Matching & Analysis">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- DBC Matches -->
                        <Border Grid.Row="0" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="✅ DBC Matches" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <DataGrid x:Name="DBCMatchesGrid" 
                                          Grid.Row="1"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="80"/>
                                        <DataGridTextColumn Header="DBC Name" Binding="{Binding DBCName}" Width="150"/>
                                        <DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" Width="60"/>
                                        <DataGridTextColumn Header="DBC Signals" Binding="{Binding DBCSignalCount}" Width="80"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="80"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Correlations -->
                        <Border Grid.Row="2" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="📈 Signal Correlations" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <DataGrid x:Name="CorrelationsGrid" 
                                          Grid.Row="1"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Signal 1" Binding="{Binding Signal1}" Width="100"/>
                                        <DataGridTextColumn Header="Signal 2" Binding="{Binding Signal2}" Width="100"/>
                                        <DataGridTextColumn Header="Correlation" Binding="{Binding Correlation}" Width="80"/>
                                        <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Panel 3: Patterns & Visualizations -->
                <TabItem Header="📊 Patterns & Visualizations">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Patterns -->
                        <Border Grid.Row="0" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🔄 Detected Patterns" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <DataGrid x:Name="PatternsGrid" 
                                          Grid.Row="1"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                                        <DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="80"/>
                                        <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="80"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="80"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Charts -->
                        <Border Grid.Row="2" Background="#252526" Margin="5" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="📊 Analysis Charts" 
                                           Foreground="#569CD6" 
                                           FontWeight="Bold"
                                           Margin="10,5"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Frequency Chart -->
                                    <Border Grid.Column="0" Background="#1E1E1E" Margin="2" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="Message Frequency" 
                                                       Foreground="#D4D4D4" 
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5"/>
                                            <oxy:PlotView Model="{Binding FrequencyChart}" 
                                                          Height="200"
                                                          Margin="5"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Signal Distribution Chart -->
                                    <Border Grid.Column="1" Background="#1E1E1E" Margin="2" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="Signal Distribution" 
                                                       Foreground="#D4D4D4" 
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5"/>
                                            <oxy:PlotView Model="{Binding SignalDistributionChart}" 
                                                          Height="200"
                                                          Margin="5"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Network Load Chart -->
                                    <Border Grid.Column="2" Background="#1E1E1E" Margin="2" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="Network Load" 
                                                       Foreground="#D4D4D4" 
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5"/>
                                            <oxy:PlotView Model="{Binding NetworkLoadChart}" 
                                                          Height="200"
                                                          Margin="5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="4" Background="#252526" Height="30">
            <TextBlock x:Name="FooterText" 
                       Text="Ready" 
                       Foreground="#D4D4D4" 
                       Margin="20,0"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>